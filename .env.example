# Configuração de envio de e-mails (SMTP Outlook/Office 365)
# Copie este arquivo para `.env` e preencha com suas credenciais.
# O `.env` é ignorado pelo Git — nunca commite a senha.
#
# IMPORTANTE: este arquivo carrega APENAS as variáveis GIVEAWAY_SMTP_*.
# O auto-updater NÃO usa credenciais (releases são públicas).
#
# O único token do projeto é o de PUBLICAÇÃO de releases (escrita), usado
# somente no ambiente de desenvolvimento, no shell do dev ou na chave
# GITHUB_RELEASE_TOKEN do `.env` local (gitignored). Ex.:
#     $env:GITHUB_RELEASE_TOKEN = "seu_token"
#     uv run python main_exe.py --release
#
# O GITHUB_RELEASE_TOKEN nunca vai para o executável nem para o usuário final.

GIVEAWAY_SMTP_HOST=smtp.office365.com
GIVEAWAY_SMTP_PORT=587
GIVEAWAY_SMTP_LOGIN=seu.login@dominio.com
GIVEAWAY_SMTP_PASS=SUA_SENHA
GIVEAWAY_SMTP_FROM=caixa.compartilhada@dominio.com
GIVEAWAY_SMTP_TO=destino@example.com